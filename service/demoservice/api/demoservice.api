syntax = "v1"

info (
	title:   "demoservice"
	desc:    "placeholder demo service"
	author:  "charlie"
	version: "v1"
)

type HelloReq {
	UserId string `form:"user_id,optional"`
}

type HelloResp {
	Message string `json:"message"`
	UserId  string `json:"user_id"`
}

@server (
	prefix: /api/v1
)
service demoservice {
	@handler Hello
	get /hello (HelloReq) returns (HelloResp)
}

