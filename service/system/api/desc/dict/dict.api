syntax = "v1"

// DictInfo 字典行（类型与项字段相同，靠 parent_id 区分）。
type DictInfo {
	Id        string `json:"id"`
	ParentId  string `json:"parent_id"`
	DictCode  string `json:"dict_code"`
	Label     string `json:"label"`
	Value     string `json:"value"`
	Sort      string `json:"sort"`
	Status    string `json:"status"`
	Remark    string `json:"remark"`
	CreatedBy string `json:"created_by"`
	UpdatedBy string `json:"updated_by"`
	CreatedAt string `json:"created_at"`
	UpdatedAt string `json:"updated_at"`
}

type DictTypeCreateReq {
	DictCode string `json:"dict_code"`
	Label    string `json:"label"`
	Sort     string `json:"sort,optional"`
	Status   string `json:"status,optional"`
	Remark   string `json:"remark,optional"`
}

type DictTypeUpdateReq {
	Id     string `json:"id"`
	Label  string `json:"label,optional"`
	Sort   string `json:"sort,optional"`
	Status string `json:"status,optional"`
	Remark string `json:"remark,optional"`
}

type DictTypeDetailReq {
	Id string `form:"id"`
}

type DictTypePageReq {
	Page     string `form:"page"`
	PageSize string `form:"page_size"`
	DictCode string `form:"dict_code,optional"`
	Label    string `form:"label,optional"`
	Status   string `form:"status,optional"`
}

type DictTypePageResp {
	Items    []DictInfo `json:"items"`
	Page     string     `json:"page"`
	PageSize string     `json:"page_size"`
	Total    string     `json:"total"`
}

type DictItemCreateReq {
	ParentId string `json:"parent_id"`
	Label    string `json:"label"`
	Value    string `json:"value"`
	Sort     string `json:"sort,optional"`
	Status   string `json:"status,optional"`
	Remark   string `json:"remark,optional"`
}

type DictItemUpdateReq {
	Id     string `json:"id"`
	Label  string `json:"label,optional"`
	Value  string `json:"value,optional"`
	Sort   string `json:"sort,optional"`
	Status string `json:"status,optional"`
	Remark string `json:"remark,optional"`
}

type DictItemDetailReq {
	Id string `form:"id"`
}

type DictItemPageReq {
	Page     string `form:"page"`
	PageSize string `form:"page_size"`
	ParentId string `form:"parent_id"`
	Label    string `form:"label,optional"`
	Value    string `form:"value,optional"`
	Status   string `form:"status,optional"`
}

type DictItemPageResp {
	Items    []DictInfo `json:"items"`
	Page     string     `json:"page"`
	PageSize string     `json:"page_size"`
	Total    string     `json:"total"`
}

type DictByCodeReq {
	DictCode string `form:"dict_code"`
}

type DictByCodeItem {
	Label string `json:"label"`
	Value string `json:"value"`
	Sort  string `json:"sort"`
}

type DictByCodeResp {
	Items []DictByCodeItem `json:"items"`
}

@server (
	prefix:     /api/v1
	group:      dict
	middleware: Auth,OperLog
)
service system {
	@handler DictTypeCreate
	post /dict/type/create (DictTypeCreateReq) returns (IdResp)

	@handler DictTypeUpdate
	post /dict/type/update (DictTypeUpdateReq)

	@handler DictTypeDelete
	post /dict/type/delete (IdsReq)

	@handler DictTypeDetail
	get /dict/type/detail (DictTypeDetailReq) returns (DictInfo)

	@handler DictTypePage
	get /dict/type/page (DictTypePageReq) returns (DictTypePageResp)

	@handler DictItemCreate
	post /dict/item/create (DictItemCreateReq) returns (IdResp)

	@handler DictItemUpdate
	post /dict/item/update (DictItemUpdateReq)

	@handler DictItemDelete
	post /dict/item/delete (IdsReq)

	@handler DictItemDetail
	get /dict/item/detail (DictItemDetailReq) returns (DictInfo)

	@handler DictItemPage
	get /dict/item/page (DictItemPageReq) returns (DictItemPageResp)

	@handler DictByCode
	get /dict/by_code (DictByCodeReq) returns (DictByCodeResp)
}
