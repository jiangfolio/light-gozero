syntax = "v1"

type DictCreateReq {
	ParentId string `json:"parent_id,optional"`
	DictCode string `json:"dict_code"`
	Label    string `json:"label"`
	Value    string `json:"value,optional"`
	Sort     string `json:"sort,optional"`
	Status   string `json:"status,optional"`
	Remark   string `json:"remark,optional"`
}

type DictUpdateReq {
	Id       string `json:"id"`
	Label    string `json:"label,optional"`
	Value    string `json:"value,optional"`
	Sort     string `json:"sort,optional"`
	Status   string `json:"status,optional"`
	Remark   string `json:"remark,optional"`
}

type DictDetailReq {
	Id string `form:"id"`
}

type DictItem {
	Id        string `json:"id"`
	ParentId  string `json:"parent_id"`
	DictCode  string `json:"dict_code"`
	Label     string `json:"label"`
	Value     string `json:"value"`
	Sort      string `json:"sort"`
	Status    string `json:"status"`
	Remark    string `json:"remark"`
	CreatedBy string `json:"created_by"`
	UpdatedBy string `json:"updated_by"`
	CreatedAt string `json:"created_at"`
	UpdatedAt string `json:"updated_at"`
}

type DictPageReq {
	Page     string `form:"page"`
	PageSize string `form:"page_size"`
	ParentId string `form:"parent_id,optional"`
	DictCode string `form:"dict_code,optional"`
	Label    string `form:"label,optional"`
	Status   string `form:"status,optional"`
}

type DictPageResp {
	Items    []DictItem `json:"items"`
	Page     string     `json:"page"`
	PageSize string     `json:"page_size"`
	Total    string     `json:"total"`
}

type DictByCodeReq {
	DictCode string `form:"dict_code"`
}

type DictByCodeItem {
	Label string `json:"label"`
	Value string `json:"value"`
	Sort  string `json:"sort"`
}

type DictByCodeResp {
	Items []DictByCodeItem `json:"items"`
}

@server (
	prefix:     /api/v1
	group:      dict
	middleware: Auth,OperLog
)
service system {
	@handler DictCreate
	post /dict/create (DictCreateReq) returns (IdResp)

	@handler DictUpdate
	post /dict/update (DictUpdateReq)

	@handler DictDelete
	post /dict/delete (IdsReq)

	@handler DictDetail
	get /dict/detail (DictDetailReq) returns (DictItem)

	@handler DictPage
	get /dict/page (DictPageReq) returns (DictPageResp)

	@handler DictByCode
	get /dict/by_code (DictByCodeReq) returns (DictByCodeResp)
}
